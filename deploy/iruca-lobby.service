[Unit]
Description=iruca streaming chinchiro lobby
After=network-online.target

[Service]
Type=simple
User=iruca-lobby
Group=iruca-lobby
WorkingDirectory=/srv/iruca-lobby/current
ExecStart=/usr/bin/node /srv/iruca-lobby/releases/RELEASE_ID/server-vps.mjs
Environment=HOST=127.0.0.1
Environment=PORT=3190
Environment=LOBBY_DB=/var/lib/iruca-lobby/lobby.sqlite
StateDirectory=iruca-lobby
StateDirectoryMode=0700
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/iruca-lobby
UMask=0077

[Install]
WantedBy=multi-user.target
