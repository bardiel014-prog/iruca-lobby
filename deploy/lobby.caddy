# Insert these routes INSIDE the existing iruca.tech route block,
# BEFORE @bad_method / method rejection and the portal catch-all.
redir /lobby /lobby/ 308
handle_path /lobby/* {
    header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
    header Cache-Control "no-store"
    reverse_proxy 127.0.0.1:3190
}
